#!/usr/bin/env bash
#
# collect-project-details.sh
#
# Interactively prompts for project details (Project Name, Jira No,
# Archer ID Demand, Environment) and the list of namespaces to validate,
# writes them to project.conf / namespaces.txt, and then runs
# generate-project-dcr-report.sh to produce the DCR compliance report.
#
# Usage:
#   ./collect-project-details.sh
#
# All prompts have sensible re-entry on empty input for required fields.
# Existing project.conf / namespaces.txt (if present) are offered as
# editable defaults so re-runs are quick.

set -uo pipefail

CONF_FILE="project.conf"
NAMESPACES_FILE="namespaces.txt"
REPORT_SCRIPT="./generate-project-dcr-report.sh"
OUTPUT_FILE=""

# ------------------------------
# Helpers
# ------------------------------
prompt_required() {
    local prompt="$1" default="$2" var
    while true; do
        if [[ -n "$default" ]]; then
            read -rp "$prompt [$default]: " var
            var="${var:-$default}"
        else
            read -rp "$prompt: " var
        fi
        if [[ -n "$var" ]]; then
            echo "$var"
            return
        fi
        echo "  This field is required - please enter a value." >&2
    done
}

prompt_optional() {
    local prompt="$1" default="$2" var
    read -rp "$prompt [$default]: " var
    echo "${var:-$default}"
}

# ------------------------------
# Load existing values as defaults, if present
# ------------------------------
DEF_PROJECT_NAME=""
DEF_JIRA_NO=""
DEF_ARCHER_ID=""
DEF_ENVIRONMENT="DR"

if [[ -f "$CONF_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONF_FILE"
    DEF_PROJECT_NAME="${PROJECT_NAME:-}"
    DEF_JIRA_NO="${JIRA_NO:-}"
    DEF_ARCHER_ID="${ARCHER_ID:-}"
    DEF_ENVIRONMENT="${ENVIRONMENT:-DR}"
fi

echo "========================================"
echo " Project Details"
echo "========================================"

PROJECT_NAME=$(prompt_required "Project Name" "$DEF_PROJECT_NAME")
JIRA_NO=$(prompt_required "Jira No" "$DEF_JIRA_NO")
ARCHER_ID=$(prompt_required "Archer ID Demand" "$DEF_ARCHER_ID")

echo "Environment options: DR / Production / UAT / SIT / DEV"
ENVIRONMENT=$(prompt_optional "Environment" "$DEF_ENVIRONMENT")

# ------------------------------
# Write project.conf
# ------------------------------
cat <<EOF > "$CONF_FILE"
# project.conf
# Generated by collect-project-details.sh on $(date '+%Y-%m-%d %H:%M:%S %Z')

PROJECT_NAME="${PROJECT_NAME}"
JIRA_NO="${JIRA_NO}"
ARCHER_ID="${ARCHER_ID}"
ENVIRONMENT="${ENVIRONMENT}"
EOF

echo
echo "Saved: $CONF_FILE"

# ------------------------------
# Collect namespaces
# ------------------------------
echo
echo "========================================"
echo " Namespaces to Validate"
echo "========================================"
echo "Enter one namespace per line. Leave blank and press Enter to finish."

declare -a NS_LIST
if [[ -f "$NAMESPACES_FILE" ]]; then
    echo "(Existing namespaces.txt found - entries below will be replaced)"
fi

while true; do
    read -rp "Namespace: " ns
    [[ -z "$ns" ]] && break
    NS_LIST+=("$ns")
done

if [[ ${#NS_LIST[@]} -eq 0 ]]; then
    echo "No namespaces entered. Exiting without generating a report." >&2
    exit 1
fi

{
    echo "# namespaces.txt"
    echo "# Generated by collect-project-details.sh on $(date '+%Y-%m-%d %H:%M:%S %Z')"
    for ns in "${NS_LIST[@]}"; do
        echo "$ns"
    done
} > "$NAMESPACES_FILE"

echo "Saved: $NAMESPACES_FILE (${#NS_LIST[@]} namespace(s))"

# ------------------------------
# Output file name
# ------------------------------
DEFAULT_OUTPUT="$(echo "$PROJECT_NAME" | tr ' ' '-' | tr -cd 'A-Za-z0-9-')-dcr-report.html"
OUTPUT_FILE=$(prompt_optional "Output HTML file name" "$DEFAULT_OUTPUT")

# ------------------------------
# Run the report generator
# ------------------------------
echo
echo "========================================"
echo " Generating DCR Report"
echo "========================================"

if [[ ! -x "$REPORT_SCRIPT" ]]; then
    if [[ -f "$REPORT_SCRIPT" ]]; then
        chmod +x "$REPORT_SCRIPT"
    else
        echo "Error: $REPORT_SCRIPT not found in current directory." >&2
        echo "project.conf and namespaces.txt were saved - run the report script manually:" >&2
        echo "  $REPORT_SCRIPT -N $NAMESPACES_FILE -c $CONF_FILE -o $OUTPUT_FILE" >&2
        exit 1
    fi
fi

"$REPORT_SCRIPT" -N "$NAMESPACES_FILE" -c "$CONF_FILE" -o "$OUTPUT_FILE"
