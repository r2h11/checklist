<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Compliance Report</title>
<style>
    body { font-family: Arial, Helvetica, sans-serif; margin: 30px; color: #222; }
    h1 { font-size: 20px; margin-bottom: 4px; }
    .meta { font-size: 12px; color: #555; margin-bottom: 20px; }
    h2.host { font-size: 15px; margin-top: 30px; margin-bottom: 6px; background: #eee; padding: 6px 8px; }
    table { border-collapse: collapse; width: 100%; margin-bottom: 10px; }
    th, td { border: 1px solid #000; padding: 6px 8px; font-size: 13px; text-align: left; vertical-align: middle; }
    th { background-color: #f2f2f2; font-weight: bold; }
    td.category { text-align: center; font-weight: bold; }
    td.compliant { color: #1a7f1a; font-weight: bold; }
    td.noncompliant { color: #c0392b; font-weight: bold; }
    td.na { color: #555; }
</style>
</head>
<body>

<h1>Compliance Report</h1>
<div class="meta">Generated: {{ now(fmt='%Y-%m-%d %H:%M:%S') }}</div>

{% for host in groups['all'] %}
{% if hostvars[host].compliance_categories is defined %}
<h2 class="host">Server: {{ host }}</h2>
<table>
    <thead>
        <tr>
            <th>Category</th>
            <th>Description Item</th>
            <th>Compliance</th>
            <th>Resolution</th>
            <th>Status</th>
            <th>Remarks</th>
        </tr>
    </thead>
    <tbody>
        {% for cat in hostvars[host].compliance_categories %}
        {% for row in cat['rows'] %}
        <tr>
            {% if loop.first %}
            <td class="category" rowspan="{{ cat['rows'] | length }}">{{ cat['category'] }}</td>
            {% endif %}
            <td>{{ row['description_item'] }}</td>
            <td class="{{ 'compliant' if row['compliance'] == 'Compliant' else ('noncompliant' if row['compliance'] == 'Non-Compliant' else 'na') }}">{{ row['compliance'] }}</td>
            <td>{{ row['resolution'] }}</td>
            <td>{{ row['status'] }}</td>
            <td>{{ row['remarks'] }}</td>
        </tr>
        {% endfor %}
        {% endfor %}
    </tbody>
</table>
{% endif %}
{% endfor %}

</body>
</html>
